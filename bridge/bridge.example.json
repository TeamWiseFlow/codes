{
  "projects": {
    "myapp": {
      "path": "/home/user/projects/myapp",
      "feishu": {
        "appId": "cli_xxx",
        "appSecretPath": "~/.codes/secrets/myapp_secret"
      },
      "codex": {
        "model": "glm-5.2",
        "provider": "maas"
      }
    },
    "backend": {
      "path": "/home/user/projects/backend",
      "feishu": {
        "appId": "cli_yyy",
        "appSecretPath": "~/.codes/secrets/backend_secret"
      },
      "codex": {
        "model": "qwen3.8-max",
        "provider": "maas",
        "contextWindow": 200000
      }
    },
    "minimal": {
      "path": "/home/user/projects/minimal",
      "feishu": {
        "appId": "cli_zzz",
        "appSecretPath": "~/.codes/secrets/minimal_secret"
      }
    }
  },
  "providers": {
    "maas": {
      "name": "Aliyun MaaS (OpenAI Responses compatible)",
      "baseUrl": "https://your-gateway.example.com/compatible-mode/v1",
      "envKey": "MAAS_API_KEY",
      "wireApi": "responses"
    }
  },
  "codexDefaults": {
    "model": "glm-5.2",
    "provider": "maas",
    "contextWindow": 200000
  },
  "thinkingThresholdMs": 2500,
  "codexPath": "codex",
  "debug": false,
  "backup": {
    "time": "04:16",
    "dest": "~/Backups"
  }
}
